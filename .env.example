# CubeSat C2 — optional overrides for docker compose.
# Copy to .env only if you need to change something. Never commit .env.
#
# Credentials are NOT configured here by default: on first start the
# `secrets` service generates random values into the cubesat-secrets volume
# and every service reads them from there. Setting one of the variables
# below pins that value instead (it is written into the volume on start).
#
# Upgrading from v0.1.0 with an existing database volume? That database
# still has its old password — pin it so the backend can log in:
#   POSTGRES_PASSWORD=devpassword

# === Credentials (leave empty to auto-generate) ===
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
REDIS_PASSWORD=
NATS_PASSWORD=
NATS_GROUNDSTATION_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# === Database names ===
POSTGRES_USER=cubesat
POSTGRES_DB=cubesat_c2

# === SatNOGS ===
# API token: https://network.satnogs.org/users/apikey/ (public endpoints work without)
SATNOGS_API_TOKEN=

# === App ===
DEBUG=false
LOG_LEVEL=INFO
# Login brute-force protection. Only E2E suites should turn this off.
LOGIN_RATE_LIMIT_ENABLED=true

# === Cesium ===
# Optional, public browser token from https://ion.cesium.com/ for
# high-resolution globe imagery. Empty = bundled offline imagery.
VITE_CESIUM_TOKEN=

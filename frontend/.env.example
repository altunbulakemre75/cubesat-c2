# Optional overrides for local development. Copy to .env if you need them.

# Cesium Ion access token — get one free at https://ion.cesium.com/
VITE_CESIUM_TOKEN=

# Leave these unset: the UI talks to the backend through its own origin
# (/api and /ws are proxied by the Vite dev server and by nginx in Docker),
# which also works from other machines on the network. Set them only when
# the UI is served without a proxy, e.g. `vite preview` in the E2E job.
# VITE_API_BASE_URL=http://localhost:8000
# VITE_WS_BASE_URL=ws://localhost:8000
